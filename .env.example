# Copy this file to .env and adjust the values.

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security - CHANGE THIS in production (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Database (SQLite file path, relative to project root)
DATABASE_PATH=./data/studyapp.db

# Initial admin account (created on first seed if it does not exist)
ADMIN_EMAIL=admin@studyapp.local
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=Platform Admin

# Password reset: when no mail provider is configured, the reset link is
# printed to the server console and (in development only) returned by the API.
EXPOSE_RESET_TOKEN_IN_DEV=true

# Java code execution.
# The server first tries a local JDK (javac/java on PATH or JAVA_HOME).
# If none is found it falls back to the public Piston API.
JAVA_RUNNER_FALLBACK_URL=https://emkc.org/api/v2/piston/execute
